<Window x:Class="Aegis.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Aegis.Desktop" Title="Aegis · Monitoring PC" Background="#080E19" Foreground="#EDF4FB" FontFamily="Segoe UI" FontSize="14" Width="1360" Height="860" MinWidth="1000" MinHeight="700" WindowStartupLocation="CenterScreen">
 <Window.Resources><BooleanToVisibilityConverter x:Key="Visible"/></Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#0B1422" BorderBrush="#1F3045" BorderThickness="0,0,1,0" Padding="22,30"><DockPanel>
   <StackPanel DockPanel.Dock="Top"><TextBlock Text="A E G I S" FontSize="27" FontWeight="Light"/><Border Background="#52DAEE" Width="36" Height="3" HorizontalAlignment="Left" Margin="0,14,0,38"/>
    <Button Content="Vue d’ensemble" Command="{Binding OverviewCommand}" HorizontalContentAlignment="Left"/>
    <Button Content="Sessions" Command="{Binding SessionsCommand}"/>
    <Button Content="Assistant" Command="{Binding AssistantCommand}"/>
    <Button Content="Matériel" Command="{Binding HardwareCommand}"/>
    <Button Content="Réglages" Command="{Binding SettingsCommand}"/>
    <Button Content="Panneau compact ↗" Command="{Binding WidgetCommand}"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"><TextBlock Text="LOCAL FIRST" Foreground="{StaticResource Accent}" FontSize="11"/><TextBlock Text="{Binding AppVersion}" Margin="0,10,0,6"/><TextBlock Style="{StaticResource MutedText}" FontSize="11" Text="Application libre et gratuite. Vos données restent sur ce PC."/></StackPanel>
   <Grid/>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="30,24,20,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,24"><TextBlock Text="{Binding Page}" FontSize="30" FontWeight="SemiBold"/><Border HorizontalAlignment="Right" Background="#132A36" CornerRadius="12" Padding="14,7" Margin="0,0,12,0"><TextBlock Text="MESURES LOCALES" Foreground="{StaticResource Accent}" FontSize="11"/></Border></Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid>
     <StackPanel Visibility="{Binding IsOverview, Converter={StaticResource Visible}}">
      <TextBlock Text="Votre PC, en temps réel." FontSize="17" Margin="0,0,0,6"/><TextBlock Style="{StaticResource MutedText}" Text="Des mesures réelles. Les capteurs absents restent visibles comme indisponibles." Margin="0,0,0,20"/>
      <UniformGrid Columns="4">
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="CPU" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Cpu}" FontSize="29" Margin="0,14,0,10" Foreground="{StaticResource Accent}"/><TextBlock Text="Charge globale" Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="GPU" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Gpu}" FontSize="24" Margin="0,14,0,10" Foreground="#B59CFF"/><TextBlock Text="{Binding SelectedDevice}" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="MÉMOIRE" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Memory}" FontSize="29" Margin="0,14,0,10"/><TextBlock Text="Physique utilisée" Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="TEMPÉRATURE" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Temperature}" FontSize="24" Margin="0,14,0,10" Foreground="#F1CA8A"/><TextBlock Text="Maximum des capteurs exposés" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel></Border>
      </UniformGrid>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Les deux dernières minutes" FontSize="18"/><TextBlock Text="CPU — cyan    Mémoire — violet    Échelle fixe 0–100 %" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"/><local:HistoryChart Height="210" Points="{Binding Chart}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Enregistrez ce qui compte" FontSize="18"/><TextBlock Style="{StaticResource MutedText}" Text="Capturez les capteurs, marquez un moment difficile et retrouvez un bilan. Choisissez un processus dans Sessions pour capturer les présentations avec PresentMon." Margin="0,8,0,12"/><WrapPanel><Button Content="{Binding RecordLabel}" Command="{Binding RecordCommand}" Background="#164452"/><Button Content="Marquer une saccade" Command="{Binding MarkerCommand}"/><Button Content="Voir les sessions" Command="{Binding SessionsCommand}"/></WrapPanel><TextBlock Text="{Binding RecordingStatus}" Style="{StaticResource MutedText}" Margin="0,10,0,0"/></StackPanel></Border>
     </StackPanel>
     <StackPanel Visibility="{Binding IsSessions,Converter={StaticResource Visible}}">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Nouvelle session" FontSize="18"/><TextBlock Text="Nom" Style="{StaticResource MutedText}" Margin="0,12,0,0"/><TextBox Text="{Binding SessionName,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Jeu, scène, résolution et réglages connus" Style="{StaticResource MutedText}"/><TextBox Text="{Binding Conditions,UpdateSourceTrigger=PropertyChanged}"/><WrapPanel><Button Content="{Binding RecordLabel}" Command="{Binding RecordCommand}"/><Button Content="Marquer une saccade" Command="{Binding MarkerCommand}"/></WrapPanel><TextBlock Text="{Binding RecordingStatus}" Style="{StaticResource MutedText}"/><TextBlock Text="Processus à capturer (facultatif)" Style="{StaticResource MutedText}" Margin="0,12,0,0"/><ComboBox ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}" DisplayMemberPath="Name"/><Button Content="Actualiser les processus" Command="{Binding RefreshProcessesCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding FrameStatus}" Style="{StaticResource MutedText}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Bibliothèque locale" FontSize="18"/><ComboBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" DisplayMemberPath="Title"/><WrapPanel><Button Content="Ouvrir le bilan" Command="{Binding LoadCommand}"/><Button Content="Exporter CSV" Command="{Binding ExportCsvCommand}"/><Button Content="Rapport HTML" Command="{Binding ExportHtmlCommand}"/></WrapPanel><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" LineHeight="22" Margin="0,16,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Avant / après" FontSize="18"/><TextBlock Text="Comparez la session sélectionnée avec :" Style="{StaticResource MutedText}" Margin="0,10,0,0"/><ComboBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding CompareSession}" DisplayMemberPath="Title"/><Button Content="Comparer les mesures" Command="{Binding CompareCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding Comparison}" TextWrapping="Wrap" LineHeight="22" Margin="0,10,0,0"/></StackPanel></Border>
     </StackPanel>
     <StackPanel Visibility="{Binding IsAssistant,Converter={StaticResource Visible}}">
      <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions><local:AvatarView Height="265" Active="{Binding IsAvatarActive}"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Une intelligence à vos côtés." FontSize="24" TextWrapping="Wrap"/><TextBlock Text="Votre session reste sur ce PC. L’assistant peut expliquer les observations avec un modèle local facultatif." Style="{StaticResource MutedText}" Margin="0,14,0,0"/><TextBlock Text="{Binding Provider}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,16,0,0"/></StackPanel></Grid></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Parlons de votre session" FontSize="18"/><TextBox Text="{Binding Question,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="65" TextWrapping="Wrap"/><WrapPanel><Button Content="Analyser" Command="{Binding AskCommand}" Background="#164452"/><Button Content="{Binding VoiceLabel}" Command="{Binding VoiceCommand}"/><Button Content="Annuler / arrêter la voix" Command="{Binding CancelCommand}"/></WrapPanel><CheckBox Content="Lire les réponses avec une voix Windows locale" IsChecked="{Binding SpeakAnswers}"/><TextBlock Text="{Binding Answer}" TextWrapping="Wrap" LineHeight="23" Margin="0,12,0,0"/><TextBlock Text="Une explication générée peut se tromper. Les preuves et le bilan calculé restent accessibles dans Sessions." Style="{StaticResource MutedText}" FontSize="12" Margin="0,16,0,0"/></StackPanel></Border>
     </StackPanel>
     <StackPanel Visibility="{Binding IsHardware,Converter={StaticResource Visible}}">
      <TextBlock Text="Capteurs et sources disponibles" FontSize="19" Margin="0,0,0,10"/><TextBlock Text="Collecte sans élévation automatique. Certains capteurs nécessitent des droits supplémentaires et restent absents. Les espaces disque indiquent l’occupation, pas un pourcentage d’activité." Style="{StaticResource MutedText}" Margin="0,0,0,18"/>
      <ItemsControl ItemsSource="{Binding MetricRows}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="14" Margin="0,0,14,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Device}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Source}" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap"/><TextBlock Grid.Column="2" Text="{Binding Reading}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel>
     <StackPanel Visibility="{Binding IsSettings,Converter={StaticResource Visible}}">
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Alertes de consultation" FontSize="18"/>
       <CheckBox Content="Activer les alertes locales (3 mesures consécutives)" IsChecked="{Binding AlertsEnabled}"/>
       <TextBlock Text="Seuils personnels, pas des limites constructeur. Les alertes sont affichées ici et ajoutées aux marqueurs de la session. Aucun réglage matériel n’est modifié." Style="{StaticResource MutedText}"/>
       <WrapPanel><StackPanel Width="150" Margin="0,10,10,0"><TextBlock Text="CPU (%)"/><TextBox Text="{Binding CpuThreshold}"/></StackPanel><StackPanel Width="150" Margin="0,10,10,0"><TextBlock Text="RAM (%)"/><TextBox Text="{Binding RamThreshold}"/></StackPanel><StackPanel Width="180" Margin="0,10,10,0"><TextBlock Text="Température max (°C)"/><TextBox Text="{Binding TempThreshold}"/></StackPanel></WrapPanel>
       <ItemsControl ItemsSource="{Binding AlertHistory}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#F1CA8A" Margin="0,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Composants facultatifs (IA et voix)" FontSize="18"/>
       <TextBlock Text="L’application fonctionne entièrement sans ces composants. Vous pouvez les installer à la demande depuis leurs sources officielles avec vérification d’intégrité SHA-256." Style="{StaticResource MutedText}" Margin="0,4,0,14"/>
       <ItemsControl ItemsSource="{Binding Components}"><ItemsControl.ItemTemplate><DataTemplate>
        <Border Background="#0C1726" BorderBrush="#1F3045" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
         <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
           <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15"/>
           <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,3,0,0"/>
           <TextBlock Text="{Binding Details}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
           <Button Content="Installer" Command="{Binding InstallCommand}" Visibility="{Binding CanInstall, Converter={StaticResource Visible}}"/>
           <Button Content="Annuler" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
           <ProgressBar Value="{Binding Progress,Mode=OneWay}" Maximum="100" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" Height="6" Margin="0,0,0,4"/>
           <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Accent}" FontSize="12"/>
          </StackPanel>
          <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Error}" Foreground="#E06C75" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" Visibility="{Binding HasError, Converter={StaticResource Visible}}"/>
         </Grid>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Assistant local" FontSize="18"/><CheckBox Content="Utiliser le modèle Ollama installé sur ce PC" IsChecked="{Binding AiEnabled}"/><TextBlock Style="{StaticResource MutedText}" Text="Connexion à 127.0.0.1 uniquement. L’analyse IA est suspendue pendant l’enregistrement pour éviter de perturber la capture."/><ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding Model}" IsEditable="True" Text="{Binding Model}"/><WrapPanel><Button Content="Démarrer le moteur IA local" Command="{Binding StartLocalAiCommand}" HorizontalAlignment="Left"/><Button Content="Détecter les modèles Ollama" Command="{Binding RefreshModelsCommand}" HorizontalAlignment="Left"/></WrapPanel></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Capture des présentations" FontSize="18"/><TextBlock Text="Chemin de PresentMon.exe" Style="{StaticResource MutedText}"/><TextBox Text="{Binding PresentMonPath,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Transcription vocale hors ligne" FontSize="18" Margin="0,16,0,0"/><TextBlock Text="Chemin de whisper-cli.exe" Style="{StaticResource MutedText}" Margin="0,10,0,0"/><TextBox Text="{Binding WhisperPath,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Chemin du modèle multilingue ggml-base.bin ou ggml-small.bin" Style="{StaticResource MutedText}"/><TextBox Text="{Binding WhisperModel,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Microphone actif uniquement après clic. Les fichiers audio temporaires sont supprimés après transcription. La lecture utilise les voix Windows locales." Style="{StaticResource MutedText}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Confort et confidentialité" FontSize="18"/><CheckBox Content="Animer le noyau 3D dans Assistant" IsChecked="{Binding Animations}"/><TextBlock Text="Aucune télémétrie, publicité ou paiement. Sessions sauvegardées dans LocalAppData/AegisNext." Style="{StaticResource MutedText}"/><Button Content="Enregistrer les réglages" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
     </StackPanel>
    </Grid>
   </ScrollViewer>
   <Border Grid.Row="2" BorderBrush="#23344A" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,14,10,0"><TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12"/></Border>
  </Grid>
 </Grid>
</Window>
