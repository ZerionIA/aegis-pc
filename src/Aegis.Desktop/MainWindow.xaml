<Window x:Class="Aegis.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Aegis.Desktop" Title="Aegis — Zerionia" Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="14" Width="1380" Height="900" MinWidth="1040" MinHeight="720" WindowStartupLocation="CenterScreen">
<Window.Resources><BooleanToVisibilityConverter x:Key="Visible"/></Window.Resources>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="22,30"><DockPanel>
<StackPanel DockPanel.Dock="Top"><TextBlock Text="Z / AEGIS" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="PC MONITOR · BY ZERIONIA" Style="{StaticResource Eyebrow}" Margin="0,10,0,34"/>
<Button Style="{StaticResource NavButton}" Content="01   Vue d’ensemble" Command="{Binding OverviewCommand}"/><Button Style="{StaticResource NavButton}" Content="02   Sessions" Command="{Binding SessionsCommand}"/><Button Style="{StaticResource NavButton}" Content="03   Capteurs" Command="{Binding HardwareCommand}"/><Button Style="{StaticResource NavButton}" Content="04   Réglages" Command="{Binding SettingsCommand}"/>
<Border Height="1" Background="{DynamicResource Line}" Margin="0,24,0,16"/><Button Content="Panneau compact ↗" Command="{Binding WidgetCommand}"/><Button Style="{StaticResource NavButton}" Content="Découvrir Zerionia ↗" Command="{Binding DiscoverCommand}"/>
</StackPanel><StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"><TextBlock Text="LOCAL. LIBRE. SANS IA." Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding AppVersion}" FontSize="12"/><TextBlock Text="Votre PC, en clair." Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"/></StackPanel><Grid/>
</DockPanel></Border>
<Grid Grid.Column="1" Margin="32,28,20,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="0,0,14,24"><StackPanel><TextBlock Text="AEGIS / ESPACE PERSONNEL" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Page}" FontSize="34" FontWeight="SemiBold"/></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="●  MESURES LOCALES" Foreground="{DynamicResource Accent}" FontSize="11" HorizontalAlignment="Right"/><Button Content="Mise à jour prête ↗" Command="{Binding InstallUpdateCommand}" Visibility="{Binding UpdateReady,Converter={StaticResource Visible}}"/></StackPanel></Grid>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid>
<StackPanel Visibility="{Binding IsOverview,Converter={StaticResource Visible}}">
<TextBlock Text="L’essentiel, sans détour." FontSize="23" Margin="0,0,0,8"/><TextBlock Text="Les mesures de votre machine. Les valeurs indisponibles restent visibles comme telles." Style="{StaticResource MutedText}" Margin="0,0,0,24"/>
<UniformGrid Columns="4">
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="CPU" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Cpu}" FontSize="32" Margin="0,8,0,12"/><TextBlock Text="Charge globale" Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="GPU" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Gpu}" FontSize="28" Margin="0,8,0,12"/><TextBlock Text="{Binding SelectedDevice}" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="MÉMOIRE" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Memory}" FontSize="32" Margin="0,8,0,12"/><TextBlock Text="Physique utilisée" Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="TEMP. MAX" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Temperature}" FontSize="28" Margin="0,8,0,12"/><TextBlock Text="Capteurs disponibles" Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></Border>
</UniformGrid>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Les deux dernières minutes" Style="{StaticResource SectionTitle}"/><TextBlock Text="CPU — cyan   /   RAM — violet   /   Échelle fixe 0–100 %" Style="{StaticResource MutedText}" FontSize="12"/><local:HistoryChart Height="180" Points="{Binding Chart}"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Gardez le contexte de votre session." FontSize="20"/><TextBlock Text="Enregistrez, marquez une saccade et retrouvez votre bilan calculé." Style="{StaticResource MutedText}" Margin="0,8,0,0"/><TextBlock Text="{Binding RecordingStatus}" Foreground="{DynamicResource Accent}" Margin="0,10,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="20,0,0,0"><Button Content="{Binding RecordLabel}" Command="{Binding RecordCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="Marquer une saccade" Command="{Binding MarkerCommand}"/></StackPanel></Grid></Border>
</StackPanel>
<StackPanel Visibility="{Binding IsSessions,Converter={StaticResource Visible}}">
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="NOUVEL ENREGISTREMENT" Style="{StaticResource Eyebrow}"/><TextBlock Text="Une session, un point de comparaison." Style="{StaticResource SectionTitle}"/><TextBlock Text="Nom de la session" Style="{StaticResource MutedText}"/><TextBox Text="{Binding SessionName,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Jeu, scène, résolution et réglages" Style="{StaticResource MutedText}"/><TextBox Text="{Binding Conditions,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Processus pour les présentations (facultatif)" Style="{StaticResource MutedText}"/><ComboBox ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}" DisplayMemberPath="Name"/><WrapPanel><Button Content="{Binding RecordLabel}" Command="{Binding RecordCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="Marquer une saccade" Command="{Binding MarkerCommand}"/><Button Content="Actualiser les processus" Command="{Binding RefreshProcessesCommand}"/></WrapPanel><TextBlock Text="{Binding RecordingStatus}" Foreground="{DynamicResource Accent}" Margin="0,10,0,8"/><TextBlock Text="{Binding FrameStatus}" Style="{StaticResource MutedText}"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Bibliothèque locale" Style="{StaticResource SectionTitle}"/><ComboBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" DisplayMemberPath="Title"/><WrapPanel><Button Content="Ouvrir le bilan" Command="{Binding LoadCommand}"/><Button Content="Exporter CSV" Command="{Binding ExportCsvCommand}"/><Button Content="Rapport HTML" Command="{Binding ExportHtmlCommand}"/></WrapPanel><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" LineHeight="23" Margin="0,16,0,0"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Avant / après" Style="{StaticResource SectionTitle}"/><TextBlock Text="Comparer la session sélectionnée avec :" Style="{StaticResource MutedText}"/><ComboBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding CompareSession}" DisplayMemberPath="Title"/><Button Content="Comparer les mesures" Command="{Binding CompareCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding Comparison}" TextWrapping="Wrap" LineHeight="22" Margin="0,10,0,0"/></StackPanel></Border>
</StackPanel>
<StackPanel Visibility="{Binding IsHardware,Converter={StaticResource Visible}}"><TextBlock Text="Vos capteurs. Leurs sources." Style="{StaticResource SectionTitle}"/><TextBlock Text="Les températures dépendent du matériel et des droits disponibles. L’espace disque indique l’occupation, pas l’activité." Style="{StaticResource MutedText}" Margin="0,0,0,20"/><ItemsControl ItemsSource="{Binding MetricRows}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="16" Margin="0,0,14,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Device}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Source}" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Reading}" Foreground="{DynamicResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
<StackPanel Visibility="{Binding IsSettings,Converter={StaticResource Visible}}">
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Apparence" Style="{StaticResource SectionTitle}"/><TextBlock Text="Un thème pour votre espace de travail." Style="{StaticResource MutedText}"/><ComboBox ItemsSource="{Binding Themes}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding Theme}" Width="260" HorizontalAlignment="Left"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Mises à jour" Style="{StaticResource SectionTitle}"/><CheckBox Content="Vérifier et télécharger automatiquement les nouvelles releases" IsChecked="{Binding AutoUpdates}"/><TextBlock Text="Connexion à GitHub, au plus une fois par jour. Les téléchargements s’interrompent pendant les sessions. Installation après confirmation, avec conservation des données." Style="{StaticResource MutedText}"/><TextBlock Text="Intégrité SHA-256 vérifiée depuis GitHub. Cette bêta ne dispose pas de signature Authenticode." Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,8"/><TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Foreground="{DynamicResource Accent}"/><ProgressBar Value="{Binding UpdateProgress,Mode=OneWay}" Visibility="{Binding UpdateBusy,Converter={StaticResource Visible}}" Margin="0,14,0,10"/><WrapPanel><Button Content="Vérifier maintenant" Command="{Binding CheckUpdatesCommand}"/><Button Content="Installer et redémarrer Aegis" Command="{Binding InstallUpdateCommand}" Visibility="{Binding UpdateReady,Converter={StaticResource Visible}}" Style="{StaticResource PrimaryButton}"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Alertes de consultation" Style="{StaticResource SectionTitle}"/><CheckBox Content="Activer les alertes locales après trois mesures consécutives" IsChecked="{Binding AlertsEnabled}"/><TextBlock Text="Seuils personnels, pas des limites constructeur. Les événements sont conservés dans l’historique récent et dans les marqueurs de la session active." Style="{StaticResource MutedText}"/><WrapPanel><StackPanel Width="150" Margin="0,12,12,0"><TextBlock Text="CPU (%)"/><TextBox Text="{Binding CpuThreshold}"/></StackPanel><StackPanel Width="150" Margin="0,12,12,0"><TextBlock Text="RAM (%)"/><TextBox Text="{Binding RamThreshold}"/></StackPanel><StackPanel Width="180" Margin="0,12,12,0"><TextBlock Text="Temp. max (°C)"/><TextBox Text="{Binding TempThreshold}"/></StackPanel></WrapPanel><ItemsControl ItemsSource="{Binding AlertHistory}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource Accent}" Margin="0,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Capture des présentations" Style="{StaticResource SectionTitle}"/><TextBlock Text="Chemin de PresentMon.exe" Style="{StaticResource MutedText}"/><TextBox Text="{Binding PresentMonPath,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Aucune élévation automatique ni modification de vos réglages matériels." Style="{StaticResource MutedText}"/><Button Content="Enregistrer les réglages" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/></StackPanel></Border>
</StackPanel>
<StackPanel Visibility="{Binding IsDiscover,Converter={StaticResource Visible}}"><TextBlock Text="Le studio derrière Aegis." FontSize="38" FontWeight="SemiBold" Margin="0,0,0,16"/><TextBlock Text="Des outils utiles, des projets indépendants et des nouvelles quand ils évoluent. Retrouvez-nous sur nos canaux." Style="{StaticResource MutedText}" Margin="0,0,0,28"/><ItemsControl ItemsSource="{Binding Projects}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}"/></StackPanel><Button Grid.Column="1" Content="Ouvrir ↗" Command="{Binding DataContext.OpenProjectCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" VerticalAlignment="Center" Margin="20,0,0,0"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Sans publicité intrusive. Aucun lien ne s’ouvre automatiquement." Style="{StaticResource MutedText}" FontSize="12"/></StackPanel>
</Grid></ScrollViewer>
<Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,16,14,0"><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12"/></Border>
</Grid></Grid></Window>